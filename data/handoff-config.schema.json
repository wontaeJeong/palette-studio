              ]
            },
            "breadcrumb": {
              "enum": [
                "soft",
                "outline",
                "solid"
              ]
            },
            "pagination": {
              "enum": [
                "soft",
                "outline",
                "solid"
              ]
            },
            "card": {
              "enum": [
                "soft",
                "outline",
                "solid"
              ]
            },
            "badge": {
              "enum": [
                "soft",
                "outline",
