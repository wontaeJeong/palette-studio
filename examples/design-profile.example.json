{
  "$schema": "../data/profile.schema.json",
  "kitVersion": "1.1.0",
  "palette": "graphite-plum",
  "style": "operational",
  "target": "existing-gate",
  "scope": "dark-only",
  "previewMode": "dark",
  "fonts": {
    "body": "pretendard",
    "code": "d2coding",
